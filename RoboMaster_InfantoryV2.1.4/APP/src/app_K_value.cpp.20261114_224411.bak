void LQR_K_GetInterpolated(float leg_length_m, K_Fixed_Leg_t output) {
    if (!isfinite(leg_length_m)) leg_length_m = LQR_K_SCHEDULE_MIN_LENGTH_M;
    if (leg_length_m <= LQR_K_Schedule[0].leg_length_m) {
        for (uint32_t row = 0; row < 4U; ++row)
            for (uint32_t col = 0; col < 10U; ++col) output[row][col] = LQR_K_Schedule[0].gain[row][col];
        return;
    }
    if (leg_length_m >= LQR_K_Schedule[LQR_K_SCHEDULE_COUNT - 1U].leg_length_m) {
        for (uint32_t row = 0; row < 4U; ++row)
            for (uint32_t col = 0; col < 10U; ++col) output[row][col] = LQR_K_Schedule[LQR_K_SCHEDULE_COUNT - 1U].gain[row][col];
        return;
    }
    uint32_t lower = (uint32_t)((leg_length_m - LQR_K_SCHEDULE_MIN_LENGTH_M) / LQR_K_SCHEDULE_STEP_M);
    if (lower >= LQR_K_SCHEDULE_COUNT - 1U) lower = LQR_K_SCHEDULE_COUNT - 2U;
    const float lo = LQR_K_Schedule[lower].leg_length_m;
    const float hi = LQR_K_Schedule[lower + 1U].leg_length_m;
    const float ratio = (leg_length_m - lo) / (hi - lo);
    for (uint32_t row = 0; row < 4U; ++row)
        for (uint32_t col = 0; col < 10U; ++col)
            output[row][col] = LQR_K_Schedule[lower].gain[row][col] +
                (LQR_K_Schedule[lower + 1U].gain[row][col] - LQR_K_Schedule[lower].gain[row][col]) * ratio;
}

void LQR_K_CalculateWithGain(Classic_Data_t *pClassicData,
                             K_Fixed_Leg_t gain,
                             float theta_ref, float d_theta_ref,
                             float theta_l_ref, float d_theta_l_ref,
                             float theta_r_ref, float d_theta_r_ref) {
    const float x_pos_lqr = fminf(fmaxf(pClassicData->States_Data.X_pos, -1.00f), 1.00f);
    float states[10] = {
        x_pos_lqr, pClassicData->States_Data.d_x_err,
        pClassicData->States_Data.yaw_err, pClassicData->States_Data.d_yaw_err,
        pClassicData->States_Data.theta_L - theta_l_ref, pClassicData->States_Data.d_theta_L - d_theta_l_ref,
        pClassicData->States_Data.theta_R - theta_r_ref, pClassicData->States_Data.d_theta_R - d_theta_r_ref,
        -(pClassicData->States_Data.theta - theta_ref),
        -(pClassicData->States_Data.d_theta - d_theta_ref)
    };
    float control[4] = {0.0f};
    arm_matrix_instance_f32 K = {4, 10, &gain[0][0]};
    arm_matrix_instance_f32 state = {10, 1, states};
    arm_matrix_instance_f32 output = {4, 1, control};
    arm_mat_mult_f32(&K, &state, &output);
    pClassicData->Contronller_Data.Fw_L = control[0];
    pClassicData->Contronller_Data.Fw_R = control[1];
    pClassicData->Contronller_Data.Tp_L = control[2];
    pClassicData->Contronller_Data.Tp_R = control[3];
}

void LQR_LimitWheelForces(Classic_Data_t *pClassicData) {
    pClassicData->Contronller_Data.Fw_L = LQR_ClampSymmetric(pClassicData->Contronller_Data.Fw_L, LQR_WHEEL_FORCE_LIMIT_N);
    pClassicData->Contronller_Data.Fw_R = LQR_ClampSymmetric(pClassicData->Contronller_Data.Fw_R, LQR_WHEEL_FORCE_LIMIT_N);
}
